<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Nếu yêu cầu là một thư mục hoặc file có thật thì bỏ qua, cho truy cập thẳng
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    
    # Nếu là đường dẫn ảo (như /api/products), ép Apache ném về cho index.php xử lý
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>